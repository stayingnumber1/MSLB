<Window x:Class="MotorLoadBench.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MotorLoadBench.UI"
 Title="KAMINGO Motor Load Bench" Width="1600" Height="900" MinWidth="1100" MinHeight="650" WindowState="Maximized" Background="#0E1A27" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EAF1F4"/><Setter Property="Background" Value="#244259"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F4F8FB"/><Setter Property="Background" Value="#102131"/><Setter Property="BorderBrush" Value="#385163"/><Setter Property="Padding" Value="7,3"/><Setter Property="Margin" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#213346"/><Setter Property="Background" Value="#EDF2F5"/><Setter Property="Padding" Value="4,2"/><Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="12"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#213346"/><Setter Property="Background" Value="#F7F9FA"/>
   <Setter Property="Padding" Value="7,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#D7EEF7"/><Setter Property="Foreground" Value="#10283B"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#B9DDEA"/><Setter Property="Foreground" Value="#0C2233"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#7890A0"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Green" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#178D78"/></Style>
  <Style x:Key="Stop" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#D94A2F"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="ArrowButton" TargetType="Button">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/><Setter Property="Background" Value="#F1F4F5"/><Setter Property="Foreground" Value="#101820"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Opacity" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#142536"/><Setter Property="BorderBrush" Value="#2D5565"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/></Style>
  <Style x:Key="ML" TargetType="TextBlock"><Setter Property="Foreground" Value="#9FB6C3"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="MV" TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF6F8"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <DataTemplate x:Key="PortItemTemplate"><TextBlock Text="{Binding DisplayName}" Foreground="#213346" Background="Transparent" FontSize="10" VerticalAlignment="Center"/></DataTemplate>
  <DataTemplate x:Key="StringItemTemplate"><TextBlock Text="{Binding}" Foreground="#213346" Background="Transparent" FontSize="10" VerticalAlignment="Center"/></DataTemplate>
 </Window.Resources>
 <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
  <Canvas Width="2048" Height="1140" Background="#0E1A27">
   <Border Width="2048" Height="70" Background="#0C1825"/>
   <TextBlock Canvas.Left="15" Canvas.Top="8" Text="KAMINGO MOTOR LOAD BENCH" FontSize="23" FontWeight="Bold" Foreground="#F0F5F8"/>
   <TextBlock Canvas.Left="15" Canvas.Top="39" Text="伺服阻尼加载 · DUT 控速 / 负载闭环控制" FontSize="12" Foreground="#9FB6C6"/>
   <StackPanel Canvas.Left="1660" Canvas.Top="10" Width="360"><TextBlock Text="{Binding ConnectionText}" Foreground="#74D1AC" HorizontalAlignment="Right"/><TextBlock Text="演示数据 · 限值 30 V / 3000 RPM / 35 A / 1050 W" Foreground="#9FB6C6" FontSize="12" HorizontalAlignment="Right" Margin="0,7,0,0"/></StackPanel>

   <TabControl Canvas.Left="15" Canvas.Top="70" Width="2019" Height="910" Background="#0E1A27" BorderThickness="0" Padding="0">
    <TabItem Header="测试控制" Width="110" Padding="12,7" Margin="0">
     <Canvas Width="2019" Height="875" Background="#0E1A27">
      <!-- M1 / VESC -->
      <Border Canvas.Left="0" Canvas.Top="10" Width="288" Height="173" Style="{StaticResource Card}" BorderBrush="#2D5C62">
       <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="20"/><RowDefinition Height="32"/><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{Binding DutConnectionColor}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding DutConnectionText}" Foreground="{Binding DutConnectionColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/></StackPanel><TextBlock Text="M1 / VESC 控制" Foreground="#73CDD5" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding DutControllerStatusDisplay}" Foreground="#ADC4D1" FontSize="11" TextTrimming="CharacterEllipsis"/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="6"/><ColumnDefinition Width="46"/><ColumnDefinition Width="6"/><ColumnDefinition Width="46"/><ColumnDefinition Width="6"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><ComboBox Height="32" FontSize="10" VerticalContentAlignment="Center" ItemsSource="{Binding DutPorts}" SelectedItem="{Binding SelectedDutPort}" ItemTemplate="{StaticResource PortItemTemplate}"/><Button Grid.Column="2" Height="32" Content="连接" Command="{Binding ConnectDutCommand}" Style="{StaticResource Green}"/><Button Grid.Column="4" Height="32" Content="断开" Command="{Binding DisconnectDutCommand}"/><Button Grid.Column="6" Height="32" Content="停止" Command="{Binding StopDutCommand}" Style="{StaticResource Stop}"/></Grid>
        <Grid Grid.Row="3" Grid.RowSpan="2" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="5"/><RowDefinition Height="32"/></Grid.RowDefinitions><TextBlock Text="ω" FontSize="16" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBox Grid.Column="1" FontSize="13" Text="{Binding DutSpeedCommandText}"/><Button Grid.Column="2" Command="{Binding DutSpeedCommand}" Style="{StaticResource ArrowButton}"><Path Width="10" Height="12" Fill="#000000" Stretch="Fill" Data="M 0,0 L 10,6 L 0,12 Z"/></Button><TextBlock Grid.Row="2" Text="Iq" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" FontSize="13" Text="{Binding DutCurrentText}"/><Button Grid.Row="2" Grid.Column="2" Command="{Binding DutCurrentCommand}" Style="{StaticResource ArrowButton}"><Path Width="10" Height="12" Fill="#000000" Stretch="Fill" Data="M 0,0 L 10,6 L 0,12 Z"/></Button></Grid>
       </Grid>
      </Border>

      <!-- EtherCAT -->
      <Border Canvas.Left="0" Canvas.Top="193" Width="288" Height="302" Style="{StaticResource Card}">
       <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="21"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{Binding EtherCatStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding EtherCatStatusText}" Foreground="{Binding EtherCatStatusColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/></StackPanel><TextBlock Text="负载伺服 / EtherCAT" Foreground="#68C8FF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Grid.Row="1" Text="{Binding ServoHeaderSummary}" FontSize="11" Foreground="#E1EEF4" TextTrimming="CharacterEllipsis"/>
        <TabControl Grid.Row="2" SelectedIndex="{Binding ServoControlTabIndex}" Background="#142536" BorderThickness="0" Padding="0" FontSize="12"><TabControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></TabControl.ItemsPanel>
         <TabItem Header="设备连接" FontSize="12" Padding="8,6" Margin="0"><StackPanel Margin="0,8,0,0"><TextBlock Text="连接设置" Foreground="#9FB6C3"/><Separator Background="#365264"/><ComboBox Height="31" FontSize="10" VerticalContentAlignment="Center" ItemsSource="{Binding ConnectionModes}" SelectedIndex="{Binding ConnectionMode}" ItemTemplate="{StaticResource StringItemTemplate}" Margin="0,7,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Height="32" FontSize="12" Content="连接" Command="{Binding ConnectCommand}" Style="{StaticResource Green}"/><Button Grid.Column="2" Height="32" FontSize="12" Content="断开" Command="{Binding DisconnectCommand}"/><Button Grid.Column="4" Height="32" FontSize="12" Content="故障复位" Command="{Binding ResetCommand}"/></Grid><TextBlock Text="伺服控制" Foreground="#9FB6C3" Margin="0,14,0,0"/><Separator Background="#365264"/><TextBlock Text="当前控制模式    CST 电子负载模式" Margin="0,6,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Height="32" FontSize="12" Content="零指令使能" Command="{Binding SelectedModeEnableCommand}" Background="#24667F"/><Button Grid.Column="2" Height="32" FontSize="12" Content="回零并失能" Command="{Binding SelectedModeDisableCommand}" Background="#A45535"/></Grid></StackPanel></TabItem>
         <TabItem Header="CSV 速度" FontSize="12" Padding="8,6" Margin="0"><StackPanel Margin="0,8,0,0"><TextBlock Text="转速 / rpm"/><TextBox Height="31" Text="{Binding DirectRpmText}"/><TextBlock Text="斜坡 / rpm/s" Margin="0,8,0,0"/><TextBox Height="31" Text="{Binding DirectRampRpmPerSecText}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Height="32" FontSize="12" Content="运行" Command="{Binding DirectRunCommand}" Style="{StaticResource Green}"/><Button Grid.Column="2" Height="32" FontSize="12" Content="停止" Command="{Binding DirectStopCommand}" Style="{StaticResource Stop}"/></Grid></StackPanel></TabItem>
         <TabItem Header="CST 负载" FontSize="12" Padding="8,6" Margin="0"><StackPanel Margin="0,8,0,0"><ComboBox Height="29" FontSize="10" VerticalContentAlignment="Center" ItemsSource="{Binding LoadModes}" SelectedIndex="{Binding LoadModeIndex}" ItemTemplate="{StaticResource StringItemTemplate}"/><UniformGrid Columns="2" Margin="0,7,0,0"><StackPanel Margin="0,0,5,5"><TextBlock Text="阻力矩 / N·m"/><TextBox Height="29" Text="{Binding TorqueText}"/></StackPanel><StackPanel Margin="5,0,0,5"><TextBlock Text="斜坡 / N·m/s"/><TextBox Height="29" Text="{Binding RampText}"/></StackPanel><StackPanel Margin="0,0,5,5"><TextBlock Text="恒功率 / W"/><TextBox Height="29" Text="{Binding PowerText}"/></StackPanel><StackPanel Margin="5,0,0,5"><TextBlock Text="仿真 DUT 转速"/><TextBox Height="29" Text="{Binding SimRpmText}"/></StackPanel></UniformGrid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Height="32" FontSize="12" Content="开始加载" Command="{Binding LoadCommand}" Style="{StaticResource Green}"/><Button Grid.Column="2" Height="32" FontSize="12" Content="停止 / 回零" Command="{Binding StopCommand}" Background="#A45535"/></Grid></StackPanel></TabItem>
        </TabControl>
       </Grid>
      </Border>

      <!-- DYN-200 -->
      <Border Canvas.Left="0" Canvas.Top="505" Width="288" Height="123" Style="{StaticResource Card}" BorderBrush="#6C5634">
       <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="34"/><RowDefinition Height="39"/></Grid.RowDefinitions>
        <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="10" Height="10" Fill="{Binding SensorConnectionColor}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding SensorConnectionText}" Foreground="{Binding SensorConnectionColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/></StackPanel><TextBlock Text="DYN-200 扭矩传感器" Foreground="#E8BD6E" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><ComboBox Height="32" FontSize="10" VerticalContentAlignment="Center" ItemsSource="{Binding SensorPorts}" SelectedItem="{Binding SelectedSensorPort}" ItemTemplate="{StaticResource PortItemTemplate}"/><Button Grid.Column="1" Height="32" FontSize="12" Content="刷新" Command="{Binding RefreshSensorPortsCommand}" Margin="7,0,0,0"/></Grid>
        <Grid Grid.Row="2" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Height="32" Content="连接" Command="{Binding ConnectSensorCommand}" Style="{StaticResource Green}"/><Button Grid.Column="2" Height="32" Content="断开" Command="{Binding DisconnectSensorCommand}"/></Grid>
       </Grid>
      </Border>

      <!-- 自动测试 -->
      <Border Canvas.Left="0" Canvas.Top="633" Width="288" Height="224" Style="{StaticResource Card}" BorderBrush="#2D5565">
       <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="13"/><RowDefinition Height="37"/><RowDefinition Height="27"/><RowDefinition Height="34"/><RowDefinition Height="31"/><RowDefinition/></Grid.RowDefinitions>
        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding AutoTestStatus}" Foreground="{Binding AutoTestStatusColor}" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="电机性能测试" Foreground="#61DEC0" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Grid.Row="1" Text="预检查点" Foreground="#61DEC0" FontSize="9"/>
        <Grid Grid.Row="2" Margin="4,0"><Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Grid.Row="0" Grid.ColumnSpan="5" Height="3" Margin="20,6" Background="#365264"/>
         <Ellipse Grid.Column="0" Width="13" Height="13" Fill="{Binding VescPrecheckColor}" Stroke="#244A5A"/><Ellipse Grid.Column="1" Width="13" Height="13" Fill="{Binding ServoPrecheckColor}" Stroke="#244A5A"/><Ellipse Grid.Column="2" Width="13" Height="13" Fill="{Binding DynPrecheckColor}" Stroke="#244A5A"/><Ellipse Grid.Column="3" Width="13" Height="13" Fill="{Binding ZeroPrecheckColor}" Stroke="#244A5A"/><Ellipse Grid.Column="4" Width="13" Height="13" Fill="{Binding ConfigPrecheckColor}" Stroke="#244A5A"/>
         <TextBlock Grid.Row="1" Text="VESC" HorizontalAlignment="Center" FontSize="9"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Servo" HorizontalAlignment="Center" FontSize="9"/><TextBlock Grid.Row="1" Grid.Column="2" Text="DYN" HorizontalAlignment="Center" FontSize="9"/><TextBlock Grid.Row="1" Grid.Column="3" Text="Zero" HorizontalAlignment="Center" FontSize="9"/><TextBlock Grid.Row="1" Grid.Column="4" Text="Config" HorizontalAlignment="Center" FontSize="9"/>
        </Grid>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="配方" Foreground="#9FB6C3" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding RecipeNameDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Height="25" Content="配置" Command="{Binding OpenRecipeCommand}" IsEnabled="{Binding AutoTestConfigurationEnabled}"/></Grid>
        <Grid Grid.Row="4" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Height="31" Content="预检查" Command="{Binding PrecheckCommand}"/><Button Grid.Column="2" Height="31" Content="开始" Command="{Binding RunRecipeCommand}" Style="{StaticResource Green}"/><Button Grid.Column="4" Height="31" Content="正常停止" Command="{Binding StopCommand}" Style="{StaticResource Stop}"/></Grid>
        <Grid Grid.Row="5" Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="72"/><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="当前状态" Foreground="#7894A5" FontSize="9"/><TextBlock Grid.Column="1" Text="{Binding Phase}" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="当前点" Foreground="#7894A5" FontSize="9"/><TextBlock Grid.Column="3" Text="{Binding AutoCurrentPoint}" FontSize="9"/><TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding AutoLiveMetrics}" Foreground="#F3C884" FontSize="8.5" TextTrimming="CharacterEllipsis"/></Grid>
        <Grid Grid.Row="6" Margin="0,6,0,0" VerticalAlignment="Top" Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="电机型号" Foreground="#9FB6C3" VerticalAlignment="Center"/><TextBox Grid.Column="1" Height="28" Padding="6,2" FontSize="11" Text="{Binding MotorModel, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsAutoTestRunning}" ToolTip="请输入本次被测电机型号；点击开始时写入测试日志"/></Grid>
       </Grid>
      </Border>

      <!-- 三张状态卡 -->
      <Border Canvas.Left="294" Canvas.Top="10" Width="568" Height="173" Style="{StaticResource Card}">
       <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="170"/><ColumnDefinition Width="148"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="3" Text="负载伺服系统" Foreground="#7ACFD5" FontWeight="Bold" FontSize="15"/><TextBlock Grid.Column="3" Text="OP/SYNC" Foreground="#7BD3A9" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="1" Text="● 转速" Style="{StaticResource ML}" Foreground="#60CBD2"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServoSpeedDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="母线电压" Style="{StaticResource ML}"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ServoBusVoltageDisplay}" Style="{StaticResource MV}"/>
        <TextBlock Grid.Row="2" Text="相电流" Style="{StaticResource ML}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServoPhaseCurrentDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="扭矩" Style="{StaticResource ML}"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ServoTorqueDisplay}" Style="{StaticResource MV}"/>
        <TextBlock Grid.Row="3" Text="伺服吸收功率" Style="{StaticResource ML}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ServoOutputPowerDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="3" Grid.Column="2" Text="伺服回馈功率" Style="{StaticResource ML}"/><TextBlock Grid.Row="3" Grid.Column="3" Text="未接入" Style="{StaticResource MV}"/>
        <TextBlock Grid.Row="4" Text="负载率" Style="{StaticResource ML}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ServoLoadDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="4" Grid.Column="2" Text="驱动模块温度" Style="{StaticResource ML}"/><TextBlock Grid.Row="4" Grid.Column="3" Text="36.1 °C" Style="{StaticResource MV}"/>
       </Grid>
      </Border>
      <Border Canvas.Left="870" Canvas.Top="10" Width="570" Height="173" Style="{StaticResource Card}" BorderBrush="#5A503F">
       <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="DYN-200 扭矩传感器" Foreground="#E8BD6E" FontWeight="Bold" FontSize="15"/><TextBlock Grid.Column="1" Text="CRC 正常" Foreground="#7BD3A9" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="1" Text="扭矩" Style="{StaticResource ML}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SensorTorqueDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="2" Text="转速" Style="{StaticResource ML}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SensorSpeedDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="3" Text="● 机械功率" Style="{StaticResource ML}" Foreground="#94D5A5"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SensorPowerDisplay}" Style="{StaticResource MV}"/>
       </Grid>
      </Border>
      <Border Canvas.Left="1448" Canvas.Top="10" Width="570" Height="173" Style="{StaticResource Card}" BorderBrush="#325B57">
       <Grid><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="174"/><ColumnDefinition Width="122"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="3" Text="被测电机 (DUT)" Foreground="#83D7BF" FontWeight="Bold" FontSize="15"/><TextBlock Grid.Column="3" Text="VESC 在线" Foreground="#7BD3A9" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="1" Text="母线电压" Style="{StaticResource ML}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DutBusVoltageDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="1" Grid.Column="2" Text="● 母线电流" Style="{StaticResource ML}" Foreground="#ECB65D"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DutBusCurrentDisplay}" Style="{StaticResource MV}"/>
        <TextBlock Grid.Row="2" Text="相电流" Style="{StaticResource ML}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DutPhaseCurrentDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="2" Grid.Column="2" Text="● 占空比" Style="{StaticResource ML}" Foreground="#60CBD2"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DutDutyDisplay}" Style="{StaticResource MV}"/>
        <TextBlock Grid.Row="3" Text="电机温度" Style="{StaticResource ML}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DutMotorTemperatureDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="3" Grid.Column="2" Text="● 效率" Style="{StaticResource ML}" Foreground="#B7ABE8"/><TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding DutEfficiencyDisplay}" Style="{StaticResource MV}"/>
        <TextBlock Grid.Row="4" Text="转速" Style="{StaticResource ML}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DutSpeedDisplay}" Style="{StaticResource MV}"/><TextBlock Grid.Row="4" Grid.Column="2" Text="● 功率" Style="{StaticResource ML}" Foreground="#94D5A5"/><TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding PowerDisplay}" Style="{StaticResource MV}"/>
       </Grid>
      </Border>

      <!-- 主区，与顶部卡片和左栏共用固定基准 -->
      <TabControl Canvas.Left="294" Canvas.Top="193" Width="1724" Height="664" SelectedIndex="1" Background="#101F2E" BorderBrush="#355365" Padding="0">
       <TabItem Header="综合曲线" Width="102" FontSize="11" Padding="12,7" Margin="0"><local:PerformanceCurveControl x:Name="PerformanceCurve"/></TabItem>
       <TabItem Header="实时波形" Width="102" FontSize="11" Padding="12,7" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="12,5"><TextBlock Text="实时波形    ● 转速    ● 目标值    ● 实测值    ● 输入功率" FontSize="13" FontWeight="Normal" VerticalAlignment="Center"/><ComboBox DockPanel.Dock="Right" Width="137" FontSize="10" VerticalContentAlignment="Center" ItemsSource="{Binding TrendWindows}" SelectedIndex="{Binding TrendWindowIndex}" ItemTemplate="{StaticResource StringItemTemplate}"/></DockPanel><local:TrendControl Grid.Row="1" x:Name="Trend"/></Grid></TabItem>
