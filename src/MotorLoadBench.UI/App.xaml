<Application x:Class="MotorLoadBench.UI.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
<SolidColorBrush x:Key="Panel" Color="#14253B"/>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DFE8F2"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="#23425C"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,3,12,8"/><Setter Property="Background" Value="#0C192A"/><Setter Property="Foreground" Value="#E6F1FB"/><Setter Property="BorderBrush" Value="#37516B"/></Style>
<Style TargetType="ComboBox"><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#172B40"/></DataTemplate></Setter.Value></Setter><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3,12,8"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DBE9F4"/><Setter Property="Margin" Value="0,5,14,5"/></Style>
<Style TargetType="TabItem"><Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#172B40"/></DataTemplate></Setter.Value></Setter><Setter Property="Padding" Value="18,8"/></Style>
</Application.Resources></Application>